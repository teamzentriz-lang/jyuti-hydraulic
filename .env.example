# Postgres from Neon or Supabase.
DATABASE_URL=

# First admin. Used only by `npm run db:seed`.
ADMIN_EMAIL=admin@jyotihydraulic.com
ADMIN_PASSWORD=change-me-now

# Public site origin, used in the admin URL preview.
NEXT_PUBLIC_SITE_URL=https://jyotihydraulic.com

# WordPress phase A import. Public REST is enough after this machine is allowed through Imunify360.
WP_ORIGIN=https://jyotihydraulic.com
# WP_USER=
# WP_APPLICATION_PASSWORD=

# Storage provider: local | r2  (STORAGE_DRIVER is a legacy alias)
STORAGE_PROVIDER=local

# Local storage (when STORAGE_PROVIDER=local)
LOCAL_STORAGE_PATH=public/uploads
LOCAL_STORAGE_URL=/uploads

# Cloudflare R2 (S3 compatible). Required only when STORAGE_PROVIDER=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Legacy alias for R2_BUCKET_NAME
# R2_BUCKET=
